theme_override_colors/font_color = Color(0.25, 0.2, 0.15, 1)
horizontal_alignment = 1

[node name="Lista" type="HBoxContainer" parent="Centro/Painel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Apresentacao" type="Label" parent="Centro/Painel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(620, 60)
layout_mode = 2
theme_override_font_sizes/font_size = 20
